import QtQuick

QtObject {
    // Spacing: distance between sibling items in RowLayout, ColumnLayout, etc.
    readonly property int spacingXS: 4
    readonly property int spacingS: 8
    readonly property int spacingM: 12
    readonly property int spacingL: 16
    readonly property int spacingXL: 24

    // Padding: distance inside a component, between border/background and content
    readonly property int paddingXS: 4
    readonly property int paddingS: 8
    readonly property int paddingM: 12
    readonly property int paddingL: 16
    readonly property int paddingXL: 24

    // Margins: distance outise a component, between the compoment and its surroundings
    readonly property int marginsXS: 4
    readonly property int marginsS: 8
    readonly property int marginsM: 12
    readonly property int marginsL: 16
    readonly property int marginsXL: 24


}
